@@ -11,13 +11,42 @@ public final class VideoView: ExpoView, AVPlayerViewControllerDelegate {
 
   weak var player: VideoPlayer? {
     didSet {
+      let previousController = playerViewController
       if playerViewControllerWrapper.setPlayer(player) {
         removeFirstFrameObserver()
         addFirstFrameObserver()
+        // [aiugc patch] The controller was rebuilt: move view-controller containment to the new one.
+        detachFromParent(previousController)
+        attachToParentIfNeeded()
       }
     }
   }
 
+  // [aiugc patch] On iOS 27, an AVPlayerViewController whose view is embedded without
+  // view-controller containment keeps playing audio but stops presenting new video frames
+  // (the picture only refreshes on pause or layout changes). Register it as a child of the
+  // React view controller that hosts this view.
+  private func attachToParentIfNeeded() {
+    #if !os(tvOS)
+    let controller = playerViewController
+    guard window != nil, controller.parent == nil, let parent = reactViewController() else {
+      return
+    }
+    parent.addChild(controller)
+    controller.didMove(toParent: parent)
+    #endif
+  }
+
+  private func detachFromParent(_ controller: UIViewController) {
+    #if !os(tvOS)
+    guard controller.parent != nil else {
+      return
+    }
+    controller.willMove(toParent: nil)
+    controller.removeFromParent()
+    #endif
+  }
+
   #if os(tvOS)
   var wasPlaying: Bool = false
   let startPictureInPictureAutomatically = false
